{
  "version": "2026-09-22-venue-sources-v1",
  "policy": {
    "automated_fetch_default": false,
    "purpose": "全国のモール・商業施設イベントを発見し、公式詳細を確認して候補化する",
    "include": [
      "キャラクターショー",
      "インフルエンサー出演",
      "ライブ",
      "ワークショップ",
      "体験",
      "展示",
      "季節イベント",
      "親子イベント",
      "地域イベント"
    ],
    "exclude_by_default": [
      "ポイントキャンペーン",
      "カード入会キャンペーン",
      "通常セール",
      "常設店舗ニュース",
      "単なる商品販売のみ"
    ],
    "publish_rule": "公式詳細で開催日・会場等を確認後。画像は利用条件確認前は使用しない。"
  },
  "targets": [
    {
      "source_key": "mall-discovery-aeonmall-corporate-events",
      "name": "イオンモール 企業イベント情報",
      "homepage_url": "https://www.aeonmall.com/",
      "event_url": "https://www.aeonmall.com/news_releases/event/",
      "role": "national_discovery",
      "venue_type": "mall",
      "acquisition_mode": "discovery_only",
      "terms_review_status": "contact_required",
      "automated_fetch_allowed": false,
      "note": "全国横断企画の発見用。個別モール開催情報は各施設公式で再確認する。"
    },
    {
      "source_key": "mall-discovery-aeontown",
      "name": "イオンタウン 各施設イベント",
      "homepage_url": "https://www.aeontown.co.jp/",
      "event_url": "https://www.aeontown.co.jp/",
      "role": "facility_directory",
      "venue_type": "mall",
      "acquisition_mode": "discovery_only",
      "terms_review_status": "contact_required",
      "automated_fetch_allowed": false,
      "note": "各SCにイベント一覧ページあり。施設URLを台帳化して個別確認する。"
    },
    {
      "source_key": "mall-discovery-mitsui-shopping-park",
      "name": "三井ショッピングパーク 各施設イベント",
      "homepage_url": "https://mitsui-shopping-park.com/",
      "event_url": "https://mitsui-shopping-park.com/lalaport/",
      "role": "facility_directory",
      "venue_type": "mall",
      "acquisition_mode": "discovery_only",
      "terms_review_status": "contact_required",
      "automated_fetch_allowed": false,
      "note": "施設ごとにイベント・キャンペーン一覧あり。イベントと販促キャンペーンを分離する。"
    },
    {
      "source_key": "mall-discovery-parco",
      "name": "PARCO 各施設 event & POPUP",
      "homepage_url": "https://parco.jp/",
      "event_url": "https://parco.jp/artculture/",
      "role": "facility_directory",
      "venue_type": "mall",
      "acquisition_mode": "discovery_only",
      "terms_review_status": "contact_required",
      "automated_fetch_allowed": false,
      "note": "各PARCOのevent & POPUPを候補発見に使用。POPUP販売のみは原則イベント検索から除外。"
    }
  ]
}
