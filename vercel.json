{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "michimamo-map.vercel.app"
        }
      ],
      "destination": "https://machimamo-map.vercel.app/:path*",
      "permanent": true
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
